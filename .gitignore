# ── Dependencies (regenerated by composer install / npm ci) ──
/backend/vendor
/frontend/node_modules
node_modules/
vendor/

# ── Build output (regenerated by npm run build) ──
/frontend/.next
/frontend/out
.next/

# ── Environment (secrets — never commit; .env.example templates ARE kept) ──
.env
.env.*
!.env.example
/backend/.env
/frontend/.env.local

# ── Credentials / onboarding exports — NEVER commit ──
teamora-onboarding-credentials.csv
*credentials*.csv
*-credentials.csv

# ── Laravel runtime ──
/backend/storage/*.key
/backend/storage/logs/*
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/bootstrap/cache/*

# ── Misc ──
.DS_Store
Thumbs.db
*.log
docs/

# Python virtualenvs (e.g. scraper tooling) — never commit; recreate from requirements.txt
.venv/
venv/

# Scraper scheduled-discovery rotation cursor. RUNTIME STATE, not configuration: it records which
# (area, category) target ran last so the next run picks up where this one stopped. Per-environment
# and self-healing — losing it just restarts the rotation, which the CRM's place_id/email dedup makes
# harmless. The target LIST itself (discovery-targets.json) IS version-controlled.
/scraper/.discovery-state.json
/scraper/.discovery.lock
/scraper/logs/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
