# ── Dependencies (regenerated by composer install / npm ci) ──
/backend/vendor
/frontend/node_modules
node_modules/
vendor/

# ── Build output (regenerated by npm run build) ──
/frontend/.next
/frontend/out
.next/

# ── Environment (secrets — never commit; .env.example templates ARE kept) ──
.env
.env.*
!.env.example
/backend/.env
/frontend/.env.local

# ── Credentials / onboarding exports — NEVER commit ──
teamora-onboarding-credentials.csv
*credentials*.csv
*-credentials.csv

# ── Laravel runtime ──
/backend/storage/*.key
/backend/storage/logs/*
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/bootstrap/cache/*

# ── Misc ──
.DS_Store
Thumbs.db
*.log
