# Discovery provider (v1: openstreetmap). Provider-agnostic — future: google_places, etc.
DISCOVERY_PROVIDER=openstreetmap

# CRM enrichment ingest target. The scraper's ONLY channel into the CRM.
# Unified platform base: <scheme>://<host>/api/v1/crm  (local Docker API listens on 8001).
# Staging/production differ only in scheme+host — never edit Python to change environment.
CRM_BASE_URL=http://localhost:8001/api/v1/crm
# Sanctum bearer token for the scraper's scoped service account. Issue it with:
#     php artisan crm:scraper-token            (add --rotate to replace the previous one)
# That provisions `scraper-service@viteseo.ph` holding ONLY `crm.leads.import` — no role, so it
# cannot reach the paid AI discovery endpoints and cannot confirm a website absence.
# Tokens are per-database: one minted on another deployment will NOT authenticate here, and a
# `migrate:fresh` invalidates it — re-run the command after any reseed.
# Leave EMPTY in this example file — never commit a real token.
CRM_TOKEN=

# OpenStreetMap endpoints (open data — no key, no billing).
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Etiquette / tuning.
USER_AGENT=CRM-Enterprise-Scraper/1.0
REQUEST_TIMEOUT=60

# --- AI-assisted discovery (optional) ------------------------------------------------
# THERE IS NO OPENAI KEY HERE, DELIBERATELY. The CRM stores the credential (encrypted) and makes
# the model call; this process asks the CRM for candidate names over the same authenticated channel
# it already uses to ingest leads. So a worker never receives, stores or logs the key.
#
# The provider itself is chosen in the CRM: Settings -> Integrations -> Nearby Lead Generation
# (Admin / Super Admin only). Precedence is --provider -> CRM setting -> DISCOVERY_PROVIDER -> osm,
# so an explicit flag still wins for ops and comparison runs, and an unreachable CRM falls back to
# the settings below rather than stopping discovery.
#
# The AI proposes NAMES; OpenStreetMap deterministically resolves them. A proposal OSM cannot
# confirm is dropped and never becomes a CRM prospect, so identity, coordinates and the dedup key
# always come from OSM — never from the model.
OPENAI_TIMEOUT=30
