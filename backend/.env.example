APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Projects (PMS) real-time uses Laravel Reverb. Left as `log` so the app boots
# without a WebSocket server; set to `reverb` in deploy once Reverb is running.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSocket server for Projects real-time collaboration).
# Fill these + run `php artisan reverb:start` at deploy; see frontend
# NEXT_PUBLIC_REVERB_* for the client side.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Per-module sender identities (config/mail.php `module_senders`). The transport above is
# SHARED — one relay, one set of credentials — while each module sends under its own address.
# Leave any of these unset and that module falls back to MAIL_FROM_* above, unchanged.
#
# The sending account must be permitted by the relay to use these envelope senders, and each
# address must exist. Setting them here does not grant that.
#
# CRM: OUTREACH_FROM_ADDRESS still works and takes precedence over MAIL_FROM_*; set
# CRM_MAIL_FROM_ADDRESS to supersede it. It must resolve to the SAME mailbox as
# OUTREACH_MAILBOX — that is the inbox polled for prospect replies, and splitting them
# stops inbound reply threading silently.
#CRM_MAIL_FROM_ADDRESS="business@example.com"
#CRM_MAIL_FROM_NAME="Zerem CRM"
#HR_MAIL_FROM_ADDRESS="hris@example.com"
#HR_MAIL_FROM_NAME="Vite SEO HR"
# PMS sends no mail yet — the identity is registered ahead of its first use.
#PMS_MAIL_FROM_ADDRESS="pms@example.com"
#PMS_MAIL_FROM_NAME="Vite SEO Projects"

# Internal CRM staff notifications (never customer mail). Off by default: when false,
# an inbound reply alerts the assigned user in-app only, exactly as in production today.
CRM_INTERNAL_REPLY_MAIL=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
