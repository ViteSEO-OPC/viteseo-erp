APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=2880
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Projects (PMS) real-time uses Laravel Reverb. Left as `log` so the app boots
# without a WebSocket server; set to `reverb` in deploy once Reverb is running.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSocket server for Projects real-time collaboration).
# Fill these + run `php artisan reverb:start` at deploy; see frontend
# NEXT_PUBLIC_REVERB_* for the client side.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Per-module sender identities (config/mail.php `module_senders`). The transport above is
# SHARED — one relay, one set of credentials — while each module sends under its own address.
# Leave any of these unset and that module falls back to MAIL_FROM_* above, unchanged.
#
# The sending account must be permitted by the relay to use these envelope senders, and each
# address must exist. Setting them here does not grant that.
#
# CRM: OUTREACH_FROM_ADDRESS still works and takes precedence over MAIL_FROM_*; set
# CRM_MAIL_FROM_ADDRESS to supersede it. It must resolve to the SAME mailbox as
# OUTREACH_MAILBOX — that is the inbox polled for prospect replies, and splitting them
# stops inbound reply threading silently.
#CRM_MAIL_FROM_ADDRESS="business@example.com"
#CRM_MAIL_FROM_NAME="Zerem CRM"
#HR_MAIL_FROM_ADDRESS="hris@example.com"
#HR_MAIL_FROM_NAME="Vite SEO HR"
# PMS sends no mail yet — the identity is registered ahead of its first use.
#PMS_MAIL_FROM_ADDRESS="pms@example.com"
#PMS_MAIL_FROM_NAME="Vite SEO Projects"
#BOOKING_MAIL_FROM_ADDRESS="booking@example.com"
#BOOKING_MAIL_FROM_NAME="Kiplo Booking"

# The customer-facing frontend origin. Used to build the links inside customer
# email (booking manage/cancel links, waitlist offers, password reset) and the
# Gmail OAuth bounce. MUST be set in production or those links point at localhost.
FRONTEND_URL=http://localhost:3000

# Comma-separated origins allowed to call the API cross-origin. Production needs
# none -- the frontend and the API share one origin. Local dev names the Next dev
# server so its requests carry the session cookie; add a LAN address if you use one.
# Unset means '*', which carries no cookie: right for production. This file gets copied
# to servers, so the local-dev line stays commented -- uncomment it on your machine:
#CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bearer-token lifetime in minutes (default 43200 = 30 days).
#SANCTUM_TOKEN_EXPIRATION=43200

# Internal CRM staff notifications (never customer mail). Off by default: when false,
# an inbound reply alerts the assigned user in-app only, exactly as in production today.
CRM_INTERNAL_REPLY_MAIL=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI — the CRM's OPTIONAL intelligence layer. Server-side only; the frontend never holds this
# key and never calls OpenAI. OFF by default: leaving these unset gives today's exact behaviour,
# because every consumer falls back to its deterministic result when AI is unavailable.
# Today this powers one capability: resolving AMBIGUOUS website-identity verdicts (one strong
# signal, uncorroborated). It can confirm such a page; it can never downgrade a confirmed one, and
# it never touches Lead Score, priority, or website_status.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Calling — OPTIONAL paid telephony. Without it Zerem uses `manual` calling: the BD dials on their own
# phone and logs the outcome in the CRM, which needs no account, no credential and nothing below.
#
# THE VALUES BELOW ARE ZEREM'S ONE CENTRALIZED VITESEO TWILIO ACCOUNT — intentional, not a fallback.
# Every authorized CRM user (the call permission plus access to the lead) places browser calls through
# this one account and caller ID. They are server-side secrets: the browser only ever receives a
# short-lived Access Token, never the Auth Token or API secret. Browser calling runs only when
# CALL_PROVIDER=twilio AND all seven values below are set; anything less keeps everyone on manual.
CALL_PROVIDER=manual

# All seven are required together; a partial set is treated as no configuration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# The PUBLIC https origin Twilio can reach this CRM on. Local development needs a tunnel — Twilio
# dials the webhook from the internet, not from your machine.
TWILIO_WEBHOOK_BASE_URL=

# Per-organization Twilio accounts (Settings → Integrations → Calling). OFF: with `false`, stored
# per-organization credentials are ignored and the centralized account above is the only one ever
# used. Do not switch on without a product decision. With `true`, each client organization calls ONLY
# through its own account (entered in the CRM, stored encrypted — never here), and one without an
# account gets manual calling, never the centralized account.
CALLING_ORGANIZATION_CREDENTIALS=false
# The organization id (ViteSEO's own) that uses the centralized account above while per-organization
# accounts are on. Unset = NO organization uses it, so set it before switching them on. Getting this
# wrong is fail-closed but SILENT — ViteSEO's own organization simply stops being recognised as central
# and loses browser calling — so it is logged as critical and `php artisan calling:doctor` reports it.
# Run that command before and after switching per-organization accounts on. Ignored while they are off.
CALLING_CENTRAL_ORG_ID=

# Office document preview — OPTIONAL. DOC/DOCX/PPT/PPTX attachments are converted to PDF by a private
# Gotenberg service (never on this server). Unset URL = those files stay Download-only, as before.
# Gotenberg must listen on a private address only and run with basic auth; these are server-side only.
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# Meta inbound webhook (Phase 3D). Disabled means the public /webhooks/meta POST
# refuses every delivery — it never means "accept without verifying".
META_WEBHOOK_ENABLED=false
# HMAC key for X-Hub-Signature-256. Empty = every delivery rejected.
META_APP_SECRET=
# Compared against hub.verify_token on the GET handshake. Empty = handshake rejected.
META_VERIFY_TOKEN=
# Optional ceilings; the defaults in config/meta.php are conservative.
# META_MAX_BODY_BYTES=1048576
# META_MAX_JSON_DEPTH=16
# META_MAX_EVENTS=200

# Nearby Clients / discovery — RUNTIME SWITCHES. Both are strict booleans (only true/1/on/yes enable)
# and default OFF, so deploying the code starts nothing by itself.
#
# A dedicated `discovery` queue worker runs on this host. Discovery runs are refused (503) until this
# is true, because the general worker does not consume the `discovery` queue and a run would otherwise
# sit "queued" forever. Start the worker on the `discovery` CONNECTION (its reservation outlives the
# 900 s jobs), with one process only:
#   php artisan queue:work discovery --queue=discovery --tries=1 --timeout=900 --max-time=3600
DISCOVERY_WORKER_ENABLED=false
# Seconds before a reserved discovery job is offered again. Must stay above the longest discovery job
# (900 s) or a still-running paid run could be picked up a second time.
# DISCOVERY_QUEUE_RETRY_AFTER=960
# The half-hourly website audit + evidence tick (`crm:enrich-websites`). Real outbound traffic, and
# its first run provisions the NERBY service account; the schedule entry is skipped and the command
# exits without touching anything until this is true.
DISCOVERY_ENRICHMENT_ENABLED=false
