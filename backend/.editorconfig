root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_size = 4

# Frozen golden email output: byte-exact, compared by EmailDesignGoldenTest. Never let an editor rewrite it.
[tests/Fixtures/EmailDesignGolden/**]
insert_final_newline = false
trim_trailing_whitespace = false
